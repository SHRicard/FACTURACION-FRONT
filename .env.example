# Plantilla de variables de entorno. Copiala a .env y completa los valores.
# Solo variables EXPO_PUBLIC_*: Expo las inlinea en el bundle, quedan VISIBLES
# en texto plano en la app. Nunca pongas secretos reales aca.

# URL base de la API REST
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Clave del storage encriptado (token de auth). Max 16 bytes con AES-128.
EXPO_PUBLIC_SECURE_STORAGE_KEY=dev-insecure-k
