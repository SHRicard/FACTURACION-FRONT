# Plantilla de variables de entorno. Copiala a .env y completa los valores.
# Solo variables EXPO_PUBLIC_*: Expo las inlinea en el bundle, quedan VISIBLES
# en texto plano en la app. Nunca pongas secretos reales aca.

# URL base de la API REST
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Clave del storage encriptado (token de auth). Max 16 bytes con AES-128.
EXPO_PUBLIC_SECURE_STORAGE_KEY=dev-insecure-k

# Login con Google. NO son secretos: viajan en el bundle igual.
# Los tres salen de console.cloud.google.com > APIs y servicios > Credenciales.
# El WEB es obligatorio en las tres plataformas: es el que hace que Google
# devuelva un ID token (sin el vuelve solo un access token, que al backend
# no le sirve). Si quedan vacios, el boton de Google no se muestra.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
